+    /// Returns the model-catalog provider for the currently selected provider.
+    /// For `.openai` this attaches the OpenAI-compatible config context (held on
+    /// the App so it outlives the async catalog preload); for every other
+    /// provider it returns the static builtin catalog as before. This is the
+    /// same provider construction the synchronous CLI path uses, applied here so
+    /// the interactive TUI catalog preload no longer receives a null context.
+    fn catalogProviderForSelected(self: *App) model_catalog.Provider {
+        const provider = self.provider_selection.selection().provider;
+        return if (provider == .openai)
+            self.openAiModelCatalogProvider()
+        else
+            builtin_providers.modelCatalog(provider);
+    }
